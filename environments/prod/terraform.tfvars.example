project_name         = "api-hub-showcase"
environment          = "prod"
aws_region           = "us-east-1"
frontend_bucket_name = "api-hub-showcase-prod-frontend"
lambda_name          = "api-hub-showcase-prod-api"
lambda_memory        = 512
lambda_timeout       = 15
domain_name          = ""

